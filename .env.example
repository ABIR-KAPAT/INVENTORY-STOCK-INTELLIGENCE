# StockWise Environment Configuration (Optional)
# StockWise runs 100% in the browser by default.
# The following variables can be configured for optional external integrations.

# App Details
VITE_APP_NAME="StockWise Inventory Intelligence"
VITE_APP_VERSION="1.0.0"

# Optional External Supplementary Products API
VITE_DUMMYJSON_API_URL="https://dummyjson.com/products"

# Default Base Currency Code (e.g. INR, USD, EUR, GBP, AED)
VITE_DEFAULT_CURRENCY="INR"
